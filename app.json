{
  "expo": {
    "name": "MindBloom",
    "slug": "mindbloom-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bloomicon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1A15"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mindbloom.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/bloomicon.png",
        "backgroundColor": "#0F1A15"
      },
      "package": "app.mindbloom.mobile"
    },
    "web": {
      "favicon": "./assets/images/bloomicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4CAF82"
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "377ebd25-b92f-4374-8f99-1e9c44ed33a3"
      }
    }
  }
}
